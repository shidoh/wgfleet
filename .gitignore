# Binaries — anchor to repo root so these match the built executables only, NOT
# the cmd/wgfleet-controller and cmd/wgfleet-agent source directories (an
# unanchored pattern matches at every level and would exclude the main packages).
/bin/
/dist/
/wgfleet-controller
/wgfleet-agent
*.exe

# Secrets — NEVER commit. WG private keys, CA keys, WARP creds, node identities.
*.key
*.pem
*.crt
!deploy/examples/*.example.crt
secrets/
*.sops.yaml
*.age

# Local state / runtime
*.db
*.db-wal
*.db-shm
state.db*

# Local config overrides (real IPs/keys live here, not in git)
controller.local.yaml
agent.local.yaml
fleet.local.yaml
*.lima.yaml
/etc-local/

# Local agent / tooling artifacts (machine-local, never published)
/.codegraph/
/.claude/
/.superpowers/
# Local maintainer context file (design notes live in the Obsidian vault)
/CLAUDE.md

# Go
/vendor/
*.test
*.out
coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Internal engineering notes — local only, never in the repository (they live in
# the maintainer's Obsidian vault). Kept ignored so they cannot come back by
# accident; the history was rewritten to drop them.
/docs/DESIGN.md
/docs/lessons.md
/docs/product.md
/docs/plans/
/docs/research/

# mkdocs build output and the root page staged into docs/ at build time
/site/
/build-docs/

# Architecture decision records and maintainer tooling — kept local with the
# rest of the engineering notes, not published.
/docs/adr/
/tools/check-awg3-status.sh
