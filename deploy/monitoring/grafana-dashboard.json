{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wgfleet", "vpn", "wireguard"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(wgfleet_node_info, node)",
        "hide": 0,
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "options": [],
        "query": { "query": "label_values(wgfleet_node_info, node)", "refId": "node" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "wgfleet — Fleet Overview",
  "uid": "wgfleet-fleet",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Nodes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_nodes)", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_nodes{state=\"Ready\"})", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Degraded",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "id": 4,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_nodes{state=\"Degraded\"})", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Error",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "id": 5,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_nodes{state=\"Error\"})", "instant": true, "refId": "A" } ]
    },
    {
      "type": "piechart",
      "title": "Nodes by state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 6,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }, "mappings": [] }, "overrides": [] },
      "options": { "displayLabels": ["name", "value"], "legend": { "displayMode": "list", "placement": "right", "showLegend": true, "values": [] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (state) (wgfleet_nodes) > 0", "instant": true, "legendFormat": "{{state}}", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Controller",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 7,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "mappings": [] }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^version$/", "values": false }, "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_build_info{component=\"controller\"}", "format": "table", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Last report age (max)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 5 },
      "id": 8,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 180 } ] }, "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(wgfleet_node_last_report_age_seconds)", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Reconcile-failing nodes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 5 },
      "id": 9,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_node_reconcile_failed)", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Drained",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 5 },
      "id": 10,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null }, { "color": "yellow", "value": 1 } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_node_drain)", "instant": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Egress blocked",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 5 },
      "id": 11,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(wgfleet_node_health_check{check=\"egress-reachability\"} == 0)", "instant": true, "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "Inventory",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 20,
      "panels": []
    },
    {
      "type": "table",
      "title": "Nodes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 21,
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "state" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "Ready": { "color": "green", "index": 0 }, "Degraded": { "color": "yellow", "index": 1 }, "Error": { "color": "red", "index": 2 } } } ] } ] },
          { "matcher": { "id": "byName", "options": "last_report_age" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 180 } ] } } ] },
          { "matcher": { "id": "byName", "options": "drain" }, "properties": [ { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "drained", "color": "yellow", "index": 0 }, "0": { "text": "", "index": 1 } } } ] }, { "id": "custom.cellOptions", "value": { "type": "color-text" } } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "Value #info": true, "Value #age": true, "Value #ver": true, "Value #drain": true, "Value #egress": true, "wire_version": true },
          "renameByName": { "node": "node", "role": "role", "region": "region", "state": "state", "agent_version": "agent", "egress_ip": "egress IP", "Value #age": "last_report_age" },
          "indexByName": { "node": 0, "role": 1, "region": 2, "state": 3, "agent_version": 4, "egress_ip": 5 }
        } }
      ],
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_node_info{node=~\"$node\"}", "format": "table", "instant": true, "refId": "info" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_node_agent_info{node=~\"$node\"}", "format": "table", "instant": true, "refId": "ver" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_node_egress_info{node=~\"$node\"}", "format": "table", "instant": true, "refId": "egress" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_node_drain{node=~\"$node\"}", "format": "table", "instant": true, "refId": "drain" }
      ]
    },
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 30,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Health checks (1 ok / 0 failing)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "id": 31,
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": true }, "mappings": [ { "type": "value", "options": { "0": { "text": "fail", "color": "red", "index": 0 }, "1": { "text": "ok", "color": "green", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "alignValue": "left", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "mergeValues": true, "rowHeight": 0.9, "showValue": "never", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_node_health_check{node=~\"$node\"}", "instant": false, "legendFormat": "{{node}} / {{check}}", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "Egress (ADR-0021 throughput watchdog)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 40,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Egress throughput per exit",
      "description": "Measured egress bandwidth (passive live traffic, or an active probe on an idle link). The dashed line is the configured floor (250 KB/s default); a sustained collapse below it auto-suspends the exit from the LB.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 29 },
      "id": 41,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "dashed" } }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 256000 } ] }, "unit": "Bps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_agent_egress_throughput_bytes{node=~\"$node\"}", "legendFormat": "{{node}}", "refId": "A" } ]
    },
    {
      "type": "state-timeline",
      "title": "Active egress method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "id": 42,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 80, "lineWidth": 0, "spanNulls": true }, "mappings": [] }, "overrides": [] },
      "options": { "alignValue": "left", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "mergeValues": true, "rowHeight": 0.9, "showValue": "always", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_agent_egress_active{node=~\"$node\"} == 1", "legendFormat": "{{node}}", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "Reconcile",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 50,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Reconcile rate by result",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 38 },
      "id": 51,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" } }, "mappings": [], "unit": "ops" }, "overrides": [ { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (result) (rate(wgfleet_agent_reconcile_total{node=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{result}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Reconcile duration p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 38 },
      "id": 52,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }, "mappings": [], "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (node, le) (rate(wgfleet_agent_reconcile_duration_seconds_bucket{node=~\"$node\"}[$__rate_interval])))", "legendFormat": "{{node}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "Config drift (resources repaired)",
      "description": "Resources the agent had to repair while the desired spec was unchanged — i.e. real drift or external tampering (ADR-0015).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 38 },
      "id": 53,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "showPoints": "never" }, "mappings": [], "unit": "short" }, "overrides": [] },
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "wgfleet_agent_drift_resources{node=~\"$node\"}", "legendFormat": "{{node}}", "refId": "A" } ]
    }
  ]
}
