# Reference systemd unit for the wgfleet controller (co-located control plane).
# The one-line installer (install.sh) drops an equivalent unit during bootstrap.
[Unit]
Description=wgfleet controller
After=network-online.target
Wants=network-online.target
# Deliberately NO StartLimit. Reaching one puts the unit in `failed`, where it stays
# until someone runs `systemctl reset-failed` — a manual step after every fixed
# config, forever, on a control plane whose whole promise is that you hand it a
# binary and it keeps working. The crash loop it was meant to make visible already
# is: a controller that cannot start does not serve /metrics, so `up == 0` and
# WgfleetControllerDown pages critical after 3m. The limit bought a distinction
# between "looping" and "gave up" and charged an operator ritual for it.

[Service]
Type=simple
ExecStart=/usr/local/bin/wgfleet-controller --config /etc/wgfleet/controller.yaml --log-format json
Restart=on-failure
RestartSec=5
# Refuse to start on a manifest this binary would reject, instead of crash-looping
# on it. --check-config changes nothing and exits non-zero when the config is bad.
ExecStartPre=/usr/local/bin/wgfleet-controller --config /etc/wgfleet/controller.yaml --check-config
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
