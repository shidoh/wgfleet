# Reference systemd unit for the wgfleet controller (co-located control plane).
# The one-line installer (install.sh) drops an equivalent unit during bootstrap.
[Unit]
Description=wgfleet controller
After=network-online.target
Wants=network-online.target
# Kept as close to systemd's defaults as it can be, on purpose. Nothing updates a
# unit after the first install — not the agent, not a binary upgrade — so anything
# added here reaches only new nodes and asks the operator to hand-edit the rest.
# Add a directive only when there is no other way to get the behaviour, and prefer
# the default every other time.
#
# Two that were tried and removed: StartLimit (lands the unit in `failed`, which
# then needs `systemctl reset-failed` after every fixed config — and the crash loop
# it made visible already pages as WgfleetControllerDown, since a controller that
# cannot start serves no /metrics), and ExecStartPre=--check-config (a nicety that
# buys nothing the same alert does not).

[Service]
Type=simple
ExecStart=/usr/local/bin/wgfleet-controller --config /etc/wgfleet/controller.yaml --log-format json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
