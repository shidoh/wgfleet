# Reference systemd unit for the wgfleet node agent. The provisioner installs an
# equivalent unit during bootstrap (internal/controller/provisioner/templates.go).
[Unit]
Description=wgfleet node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The agent exposes Prometheus /metrics on <mgmt_addr>:9301 by default, reading
# mgmt_addr from agent.yaml — no per-node flag needed (see deploy/monitoring/).
# Override with `--metrics <addr>` (refused on a public bind); `--metrics off`
# disables it. The unit stays generic across the fleet.
ExecStart=/usr/local/bin/wgfleet-agent --config /etc/wgfleet/agent.yaml --log-format json
Restart=on-failure
RestartSec=5
# The agent manages AmneziaWG interfaces, nftables and policy routing.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
